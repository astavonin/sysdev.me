{
  "name": "sysdev-me",
  "type": "module",
  "version": "1.0.0",
  "description": "Astro blog published at https://sysdev.me",
  "license": "MIT",
  "homepage": "https://sysdev.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/astavonin/sysdev.me.git"
  },
  "keywords": [
    "astro",
    "astro-theme",
    "blog",
    "vue",
    "tailwindcss"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro sync && astro check && vue-tsc --noEmit",
    "test": "pnpm check && pnpm test:unit && pnpm test:e2e",
    "test:e2e": "pnpm build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "mermaid": "^12.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@iconify-json/lucide": "^1.2.141",
    "@iconify-json/simple-icons": "^1.2.99",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "satori": "^0.59.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.33.0 <11"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@tailwindcss/typography>postcss-selector-parser": "^7.1.6"
    }
  }
}
