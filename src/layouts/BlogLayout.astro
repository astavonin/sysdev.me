---
import BaseLayout from "./BaseLayout.astro";
import LeftSidebar from "../components/home/LeftSidebar.astro";
import RightSidebar from "../components/home/RightSidebar.astro";
import { getPosts, summarize } from "../lib/posts";
import { getLanguageFromPath } from "../i18n";
interface Props {
  title?: string;
  description?: string;
  heroTitle?: string;
  home?: boolean;
  pageType?: "WebPage" | "CollectionPage" | "ProfilePage";
}
const posts = (await getPosts(getLanguageFromPath(Astro.url.pathname))).map(
  summarize,
);
---

<BaseLayout {...Astro.props}>
  <div class="shell blog-grid">
    <LeftSidebar posts={posts} />
    <div class="page-content">
      <slot />
    </div>
    <RightSidebar posts={posts} />
  </div>
</BaseLayout>
