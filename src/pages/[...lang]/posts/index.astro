---
import { getLanguage, languagePaths, useTranslations } from "../../../i18n";
import BlogLayout from "../../../layouts/BlogLayout.astro";
import PostFeed from "../../../components/posts/PostFeed.vue";
import PostListFallback from "../../../components/posts/PostListFallback.astro";
import { getPosts, summarize } from "../../../lib/posts";
export const getStaticPaths = languagePaths;
const lang = getLanguage(Astro.params.lang);
const t = useTranslations(lang);
const posts = (await getPosts(lang)).map(summarize);
---

<BlogLayout
  title={t("meta.postsTitle")}
  description={t("meta.postsDescription")}
  heroTitle={t("post.heroTitle")}
  pageType="CollectionPage"
>
  <PostFeed posts={posts} lang={lang} archive client:load />
  <PostListFallback posts={posts} />
</BlogLayout>
