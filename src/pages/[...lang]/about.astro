---
import { getLanguage, languagePaths, useTranslations } from "../../i18n";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { Content as AboutText } from "../../data/about.md";
export const getStaticPaths = languagePaths;
const lang = getLanguage(Astro.params.lang);
const t = useTranslations(lang);
---

<BlogLayout
  title={t("about.heroTitle")}
  description={t("meta.aboutDescription")}
  heroTitle={t("about.heroTitle")}
  pageType="ProfilePage"
>
  <section class="card page-card about-card">
    <div class="about-intro">
      <h2>{t("about.greeting")}</h2>
    </div>

    <div class="about-body">
      <AboutText />
    </div>
  </section>
</BlogLayout>
<style>
  /* The profile photo and the role line live in the sidebar card only — a copy
     here put both on the page twice. */
  .about-intro {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--line);
  }
  .about-intro h2 {
    font-size: 26px;
    font-weight: 600;
    line-height: 1.25;
    margin: 2px 0 0;
  }
  .about-blog {
    font-size: 16px;
    line-height: 1.7;
    margin: 24px 0 0;
  }
  .about-body {
    margin-top: 24px;
    line-height: 1.75;
  }
  .about-body :global(p) {
    margin: 0 0 16px;
  }
  .about-body :global(h2) {
    font-size: 20px;
    font-weight: 600;
    margin: 28px 0 12px;
  }
  .about-body :global(ul) {
    margin: 0;
    padding-left: 20px;
  }
  .about-body :global(li) {
    margin: 6px 0;
  }
  .about-body :global(a) {
    color: var(--accent);
  }
</style>
