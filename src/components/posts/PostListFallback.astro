---
import { getLanguageFromPath, localizePath, useTranslations } from "../../i18n";
import type { PostSummary } from "../../lib/posts";
interface Props {
  posts: PostSummary[];
}
const { posts } = Astro.props;
const lang = getLanguageFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<noscript>
  <section class="card page-card" aria-label={t("post.all")}>
    <h2>{t("post.all")}</h2>
    <p>{t("post.noScript")}</p>
    <ul>
      {posts.map((post) => (
        <li>
          <a class="text-link" href={localizePath(lang, `/posts/${post.id}/`)}>
            {post.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</noscript>
