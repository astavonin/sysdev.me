---
import {
  formatDate,
  getLanguageFromPath,
  localizePath,
  useTranslations,
} from "../../i18n";
import type { PostSummary } from "../../lib/posts";
interface Props {
  posts: PostSummary[];
}
const { posts } = Astro.props;
const lang = getLanguageFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const postsPath = localizePath(lang, "/posts/");
const months = [...new Set(posts.map((p) => p.date.slice(0, 7)))];
---

<aside class="right-sidebar" aria-label={t("sidebar.activity")}>
  <section class="card panel recent-panel">
    <h2 class="panel-title">
      <span class="icon-[lucide--clock]" aria-hidden="true"></span>
      {t("sidebar.recent")}
    </h2>
    <ol>
      {posts.slice(0, 4).map((post) => (
        <li>
          <a href={post.permalink}>
            <h3>{post.title}</h3>
            <time datetime={post.date}>{formatDate(lang, post.date)}</time>
          </a>
        </li>
      ))}
    </ol>
  </section>
  <section class="card panel archive-panel">
    <h2 class="panel-title">
      <span class="icon-[lucide--calendar]" aria-hidden="true"></span>
      {t("sidebar.archive")}
    </h2>
    {months.map((month) => (
      <a href={`${postsPath}?month=${month}`}>
        <span>
          {formatDate(lang, `${month}-01`, { year: "numeric", month: "long" })}
        </span>
        <span>
          {t("post.records", {
            count: posts.filter((p) => p.date.startsWith(month)).length,
          })}
        </span>
      </a>
    ))}
  </section>
</aside>
<style>
  .recent-panel ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .recent-panel li + li {
    margin-top: 12px;
  }
  .recent-panel h3 {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    font-weight: 500;
  }
  .recent-panel a:hover h3 {
    color: var(--accent);
  }
  .recent-panel time {
    color: var(--muted);
    font-size: 13px;
  }
  .archive-panel > a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
    padding: 5px 0;
    font-size: 15px;
  }
  .archive-panel > a span:last-child {
    white-space: nowrap;
    color: var(--muted);
    font-size: 13px;
  }
  .archive-panel > a:hover {
    color: var(--accent);
  }
</style>
