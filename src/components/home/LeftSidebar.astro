---
import { getLanguageFromPath, localizePath, useTranslations } from "../../i18n";
import PersonalCard from "./PersonalCard.vue";
import { getAvatar } from "../../lib/avatar";
import { categories, getTags, type PostSummary } from "../../lib/posts";
import { categoryLabel, categoryIcon } from "../../data/post-options";
interface Props {
  posts: PostSummary[];
}
const { posts } = Astro.props;
const lang = getLanguageFromPath(Astro.url.pathname);
const t = useTranslations(lang);
const postsPath = localizePath(lang, "/posts/");
const tags = getTags(posts);
---

<aside class="left-sidebar" aria-label={t("sidebar.profile")}>
  <PersonalCard posts={posts} lang={lang} avatar={await getAvatar(64)} />
  <section class="card panel category-panel">
    <h2 class="panel-title">
      <span class="icon-[lucide--folder]" aria-hidden="true"></span>
      {t("sidebar.categories")}
    </h2>
    {categories.map((category) => (
      <a href={`${postsPath}?category=${encodeURIComponent(category)}`}>
        <span>
          <span
            class={categoryIcon(category)}
            aria-hidden="true"
          ></span>
          {categoryLabel(lang, category)}
        </span>
        <span class="category-count">
          {posts.filter((post) => post.category === category).length}
        </span>
      </a>
    ))}
  </section>
  <section class="card panel" id="tags">
    <h2 class="panel-title">
      <span class="icon-[lucide--hash]" aria-hidden="true"></span>
      {t("sidebar.tags")}
    </h2>
    <div class="tag-cloud">
      {tags.map((tag) => (
        <a class="chip" href={`${postsPath}?tag=${encodeURIComponent(tag)}`}>
          {tag}
        </a>
      ))}
    </div>
  </section>
</aside>
<style>
  .category-panel > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
    font-size: 15px;
  }
  .category-panel > a > span:first-child {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .category-panel > a > span:first-child > span {
    font-size: 16px;
    color: var(--muted);
  }
  .category-panel > a:hover {
    color: var(--accent);
  }
  .category-panel > a:hover > span:first-child > span {
    color: var(--accent);
  }
  .category-count {
    font-size: 14px;
    color: var(--muted);
  }
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
